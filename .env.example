# Copy to .env.local for local development. Never commit real values.

# Supabase project kqmihbpjhoymiedjxtsi (URL is public; it is not a secret)
NEXT_PUBLIC_SUPABASE_URL=https://kqmihbpjhoymiedjxtsi.supabase.co
# Publishable (anon) key: safe for browsers, Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Signs table QR codes. Generate with: openssl rand -base64 48
QR_SIGNING_SECRET=

# Database tests (optional; defaults to the local dev database from scripts/dev-db.sh)
# TEST_DATABASE_URL=postgresql://postgres@localhost:54329/postgres
