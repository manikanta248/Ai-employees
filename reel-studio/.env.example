# Copy to .env and fill in. The app works WITHOUT any keys (rule-based director only).

# ---- Google Gemini (primary) ------------------------------------------------
GEMINI_API_KEY=
# Model ids are configurable because names change. Run `python scripts/list_models.py`
# to see the ids your key can use. Comma-separated = fallback chain, first that works wins.
MODEL_DIRECTOR=gemini-3.8-flash,gemini-2.5-flash
MODEL_TAGGER=gemini-3.1-flash-lite,gemini-2.5-flash-lite
MODEL_ESCALATE=gemini-3.1-pro,gemini-2.5-pro

# ---- Optional OpenAI-compatible provider (Qwen via DashScope, Kimi via Moonshot, etc.) ----
# Used only if OPENAI_COMPAT_API_KEY is set AND PROVIDER_DIRECTOR=openai_compat
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
PROVIDER_DIRECTOR=gemini

# ---- Behaviour ----------------------------------------------------------------
# Max keyframes sent to the model per request (cost control)
MAX_KEYFRAMES=24
# 1 = run the AI reviewer after render and apply one automatic fix pass
AUTO_REVIEW=0
# Where uploads and renders are stored
DATA_DIR=./data
